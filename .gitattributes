# Scripts and skill-set lists keep LF endings on every OS: bash cannot run a CRLF script, and a
# default Git for Windows clone (core.autocrlf=true) would otherwise check them out CRLF.
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
LICENSE text eol=lf
LICENSE.upstream text eol=lf
